/dist
/release

# Compiled fixtures, regenerated by testdata/build-fixtures.sh and the per-tool
# go.mod directories under testdata/. Keep the source (.go, go.mod, README.md,
# build-fixtures.sh) committed; never the binaries.
testdata/*.stripped
testdata/*.stripped.exe
testdata/*.unstripped
testdata/*.bin
testdata/*.exe
testdata/*.macho

# Inline-tree coverage probe working-tree artifacts. The decoder, the
# measurement tool, and REPORT.md are tracked under src/inline/,
# internal/inlinecov/, and internal/inlinecov/REPORT.md. Everything
# below regenerates per run.
/probe/inline-coverage/toolchains/
/probe/inline-coverage/sources/
/probe/inline-coverage/corpus/
/probe/inline-coverage/results/
/probe/inline-coverage/.gocache/
/probe/inline-coverage/.gomodcache/
/probe/inline-coverage/*.sh
/probe/inline-coverage/*.tsv
/probe/inline-coverage/DAY1.md

# Monorepo-internal scaffolding. These directories live at the parent
# Public/ working tree (Public/scripts/, Public/docs/, Public/.claude/)
# and must never be vendored into a public sub-repo. The deny rules below
# block accidental copies that land under unstrip/.
/scripts/
/docs/
/.claude/

# Allow-list for files we deliberately want under unstrip/docs/. Add new
# entries here when a new public reference doc gets authored. Anything in
# docs/ NOT listed below stays denied.
!/docs/
!/docs/USAGE.md
